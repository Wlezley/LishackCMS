{
    "name": "wlezley/lishack-cms",
    "description": "Lishack CMS",
    "keywords": [
        "lishack"
    ],
    "type": "project",
    "license": [
        "MIT",
        "BSD-3-Clause",
        "GPL-2.0",
        "GPL-3.0"
    ],
    "require": {
        "php": ">= 8.4.1",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "contributte/console": "^0.10.1",
        "doctrine/migrations": "^3.9",
        "latte/latte": "^3.0",
        "nesbot/carbon": "^3.8",
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/caching": "^3.4",
        "nette/database": "^3.2",
        "nette/di": "^3.2",
        "nette/forms": "^3.2",
        "nette/http": "^3.3",
        "nette/mail": "^4.0",
        "nette/robot-loader": "^4.1",
        "nette/security": "^3.2",
        "nette/utils": "^4.0",
        "nettrine/dbal": "^0.10.3",
        "nettrine/migrations": "^0.10.1",
        "nettrine/orm": "^0.10.1",
        "robmorgan/phinx": "^0.16.5",
        "samdark/sitemap": "^2.4",
        "symfony/var-exporter": "^8.1",
        "tracy/tracy": "^2.10",
        "ublaboo/datagrid": "^7.1.x-dev",
        "webmozart/assert": "^2.0"
    },
    "require-dev": {
        "brainmaestro/composer-git-hooks": "^3.0",
        "codeception/codeception": "^5.1",
        "codeception/module-asserts": "*",
        "codeception/module-phpbrowser": "*",
        "nette/tester": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-nette": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "slevomat/coding-standard": "^8.26"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app",
            "App\\Migrations\\": "db/migrations/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint-detail": "phpcs -s",
        "lint-fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit 512M",
        "flush-cache": "rm -rf temp/cache/* temp/phpstan/*",
        "flush-logs": "rm -rf temp/logs/*",
        "flush-phpstan": "phpstan clear-result-cache",
        "cghooks": "cghooks",
        "post-install-cmd": [
            "[ $COMPOSER_DEV_MODE -eq 0 ] || cghooks add --ignore-lock"
        ],
        "post-update-cmd": [
            "[ $COMPOSER_DEV_MODE -eq 0 ] || cghooks update"
        ]
    },
    "extra": {
        "hooks": {
            "config": {
                "stop-on-failure": ["pre-commit"]
            },
            "pre-commit": [
                "composer lint",
                "composer phpstan"
            ]
        }
    }
}
