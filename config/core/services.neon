search:
    default:
        in: %appDir%
        classes:
            - *Factory
            - *Facade
            - *Service
            - *Validator
            - *Repository
            - App\Service\**
            - App\Commands\**

extensions:
    console: Contributte\Console\DI\ConsoleExtension(%consoleMode%)
    nettrine.dbal: Nettrine\DBAL\DI\DbalExtension
    nettrine.orm: Nettrine\ORM\DI\OrmExtension
    nettrine.migrations: Nettrine\Migrations\DI\MigrationsExtension

services:
    router: App\Router\RouterFactory::createRouter
    security.passwords: Nette\Security\Passwords(::PASSWORD_BCRYPT, [cost: 12])
    authenticator: App\Models\User\Authenticator

    # Doctrine
    - App\Doctrine\SchemaAssetsFilter

    # Models
    - App\Models\Article\ArticleManager
    - App\Models\Category\CategoryManager
    - App\Models\Config\ConfigManager
    - App\Models\Helpers\AssetsVersion
    - App\Models\Installer\Installer
    - App\Models\Seo\SitemapGenerator
    - App\Models\SmsGate\SmsGate(%smsgate.url%, %smsgate.login%, %smsgate.password%, %smsgate.sender_id%, %smsgate.secured_login%)
    - App\Models\Translation\LanguageService
    - App\Models\Translation\TranslationCache
    - App\Models\Translation\TranslationService
    - App\Models\Translation\TranslatorLog
    - App\Models\Translation\TranslatorMaintenanceManager
    - App\Models\UrlGenerator\UrlGenerator

    # Dataset
    - App\Components\Admin\DatasetSidebar\IDatasetSidebarFactory
    - App\Components\Admin\DataList\IDataListFactory
    - App\Components\Admin\DataEditor\IDataEditorFactory
    - App\Components\Admin\DatasetList\IDatasetListFactory
    - App\Components\Admin\DatasetEditor\IDatasetEditorFactory
    - App\Entity\Dataset\DatasetRepository
    - App\Entity\DatasetColumn\DatasetColumnRepository
    - App\Entity\DatasetData\DatasetDataRepository

    # StorageSystem
    - App\Models\StorageSystem\Storage
    - App\Models\StorageSystem\FileUploader
    - App\Models\StorageSystem\FileManager
    - App\Models\StorageSystem\TreeManager
    - App\Models\StorageSystem\Repository\StorageFilesRepository
    - App\Models\StorageSystem\Repository\StorageTreeRepository

    # Media
    - App\Models\Media\DummyImageGenerator
    - App\Models\Media\ImageResizer
    - App\Models\Media\MediaManager

    # Vendor
    - Phinx\Console\PhinxApplication
    - Phinx\Wrapper\TextWrapper(@Phinx\Console\PhinxApplication)

    # Components
    - App\Components\Admin\UserList\UserListGrid
    - App\Components\Admin\ArticleEditor\IArticleEditorFactory
    - App\Components\Admin\ArticleList\IArticleListFactory
    - App\Components\Pagination\IPaginationFactory
    - App\Components\Admin\CategoryForm\ICategoryFormFactory
